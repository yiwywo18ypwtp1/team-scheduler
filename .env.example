# Copy to .env.local and adjust. All variables are optional.

# Absolute site URL, used for Open Graph image links. Default: http://localhost:3000
SITE_URL=http://localhost:3000

# SQLite file. Created and seeded on first start. Default: data/scheduler.db
# DATABASE_PATH=data/scheduler.db

# Freeze "now" (ISO with offset) to check DST and minNotice, e.g. the Kyiv DST night:
# MOCK_NOW=2026-10-25T00:30:00Z

# Extra latency (ms) for every API call and Server Action.
# MOCK_LATENCY_MS=0

# Probability (0..1) that an API call or Server Action fails with 503 MOCK_FAILURE.
# MOCK_FAILURE_RATE=0
